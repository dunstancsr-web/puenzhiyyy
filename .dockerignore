# Keep the build context small and, more importantly, keep host-built artifacts
# out of it. Copying a macOS node_modules into a Linux image would overwrite the
# correctly compiled better-sqlite3 binary with one that cannot load.
node_modules
**/node_modules

# Built in the image, never copied from the host.
frontend/dist
frontend/build

# Local database and its write-ahead log. The container seeds its own.
backend/data

.git
.gitignore
*.log
npm-debug.log*
.DS_Store
.vscode
.idea
.env
.env.*
# The two lines above only match at the ROOT of the build context, which is
# not where the real one lives. Unlike .gitignore, a bare .dockerignore pattern
# does not match inside subdirectories, so backend/.env (holding the gateway
# key) was being sent to every build. The Dockerfile never copies it, so no
# image contained it, but one future `COPY backend/ ./backend/` would have
# baked the key into a layer. On a host the key belongs in the platform's
# environment settings, never in the image.
**/.env
**/.env.*

# Documentation and specs: not needed at runtime.
.kiro
docs
README.md
CLAUDE.md
frontend/mockups

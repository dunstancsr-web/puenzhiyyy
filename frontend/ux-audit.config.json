 "audit": {
  "typeScale": [
   13,
   15,
   17,
   22,
   30,
   40
  ],
  "minFontPx": 12,
  "forbidText": [
   "[\\u2013\\u2014]"
  ],
  "relaxedTargetSelector": "nav"
 },
 "keyboard": {
  "enabled": true,
  "widths": [
   1440,
   390
  ],
  "maxTabs": 40
 },
 "ignore": [
  {
   "check": "T1",
   "match": "e\\.g\\. \"(\\$[\\d.]+[MK]?|[A-Z][a-z]{2})\"",
   "reason": "chart axis and value labels are 10 to 11px: the type scale's own carve-out (rules.md, type scale)"
  },
  {
   "check": "L2",
   "match": "^\"New stock movements",
   "reason": "the refresh pill is a transient bottom overlay by design; it reserves 84px of page space so the last line stays reachable (NewDataPill.jsx)"
  },
  {
   "check": "L2",
   "match": "^\"div\\.tour-scrim\"",
   "reason": "the demo tour dims the page behind its card by design while a step is open; every way out (X, Skip tour, Esc) is in the card (DemoTour.jsx)"
  },
  {
   "check": "L2",
   "match": "^\"Step \\d of 5",
   "reason": "the demo tour's card is a popover placed beside the element it lights, and may sit over nearby content (DemoTour.jsx)"
  },
  {
   "check": "L3",
   "match": "tour-scrim|Step \\d of 5",
   "reason": "the demo tour's dimming layer and card are a modal layer over the page, including the demo banner (DemoTour.jsx)"
  }
 ]
}

#!/usr/bin/env bash
# Pre-push guard for StockSense. Tracked under .githooks/, see pre-commit in
# this folder for how it gets installed.
#
# Refuses a push whose remote ref is main: main is only ever updated by
# merging a pull request, never by a direct push, see .kiro/steering/rules.md,
# "Working rules". Feature branches push through untouched.
#
# False alarm, e.g. a one-off maintainer push? git push --no-verify.

set -u

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: push refused, '$remote_ref' takes pull requests only."
      echo "Push your feature branch and open a PR into main instead."
      exit 1
      ;;
  esac
done

exit 0

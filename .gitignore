# Dependencies
node_modules/

# Database file (auto-created on startup)
backend/data/

# Build output
frontend/dist/
frontend/build/

# Environment files
.env
.env.local
.env.*.local
# The template too, since 2026-09-14. It sits beside the real .env with the
# same names and layout, and a key was typed into it once instead of into .env.
# Ignoring it means a filled-in copy can never be committed by accident. The
# cost is that a fresh clone has no template: the model settings are explained
# in backend/src/llm/provider.js, and `grep -rn process.env backend/src` lists
# every setting the server reads.
.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Personal notes (private, do not publish)
# Matches in any folder, so the guide stays private in docs/(Stan) 1 Reference/.
# A (Stan) PREFIX is tracked on purpose; only the suffix marks a private file.
CLAUDE_CLI_GUIDE.md
*(Stan).md

# UI/UX audit output and the temporary in-page harness (never commit either)
ux-audit-report/
**/__ux-audit.js

# Copy to backend/.env and fill in. backend/.env is gitignored and must stay that way.
# Never commit a real key. Never paste one into a chat window or an issue.

# ── Which tier answers "Why?" at startup ─────────────────────────────────────
# rules = no model, the deterministic trace only. local = llama3 on this
# machine. Both are free. There is deliberately NO way to start in the metered
# tier from this file: paid spending has to begin with a click in the running
# app, so nobody inherits a billing state by copying a config.
LLM_DEFAULT_MODE=local

# ── Which model backend to use ───────────────────────────────────────────────
#   ollama    local, free, no network, no credits consumed. The default for dev.
#   gateway   the organizers' AWS Bedrock gateway from the ShowMeYourAgent
#             starter kit. Ollama compatible, so it uses the same code path as
#             local ollama plus an X-API-Key header. Fronts Claude Sonnet 4.5.
#             Prefer this over `anthropic` for the demo: it is the organizers'
#             intended route and it does not draw on the team's own credit.
#   anthropic the Anthropic API directly. Draws on the shared team credit, so
#             treat it as the fallback rather than the default.
#   none      disables the model entirely. "Why?" still works and falls back to
#             the deterministic trace in frontend/src/lib/explain.js.
LLM_PROVIDER=ollama

# ── Local (ollama) ───────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Organizers' Bedrock gateway ──────────────────────────────────────────────
# Base URL only, with no trailing /api/chat: the provider appends the path.
# The gateway answers 403 on rapid successive requests, which is a rate limit
# wearing a permissions status code, so the client retries it with backoff.
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# ── Anthropic ────────────────────────────────────────────────────────────────
# Haiku is chosen deliberately. This task is rephrasing figures that have
# already been computed, not reasoning from scratch, so the cheapest capable
# model is the right one when the credit pool is shared across the team.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Spend guards ─────────────────────────────────────────────────────────────
# A hard ceiling on output length. Explanations are four short paragraphs, so
# anything much above this is a runaway, not a better answer.
LLM_MAX_OUTPUT_TOKENS=280

# Stop calling the paid API after this many calls in a rolling 24 hours. Set to
# 0 to disable the guard. This exists because a shared credit pool has no per
# developer limit of its own: one loop in one branch can spend everyone's.
LLM_DAILY_CALL_LIMIT=200
